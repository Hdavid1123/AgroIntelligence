# Copia este archivo a .env y ajusta los valores para tu entorno local.
# No commitees nunca un .env con credenciales reales.

# PostgreSQL
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@localhost:5432/agro_help_db

# Credenciales de desarrollo para el stack local. Cámbialas fuera de local.
POSTGRES_DB=agro_help_db
POSTGRES_USER=agro
POSTGRES_PASSWORD=agro_dev_password

# RustFS
RUSTFS_ACCESS_KEY=agro
RUSTFS_SECRET_KEY=agro_dev_password

# Entorno virtual de Python (opcional; normalmente se activa con
# `source .venv/bin/activate` y no hace falta declararlo aquí).
# VIRTUAL_ENV=/ruta/a/tu/entorno/virtual
